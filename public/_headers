# Cloudflare Pages / Netlify 形式のヘッダ設定。
# Vercel を使う場合は vercel.json の headers に同等の内容を置く。

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

